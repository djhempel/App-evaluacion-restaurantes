# Credenciales de tu proyecto Firebase (Configuración del proyecto > Tus apps > Web).
# Copia este archivo como ".env" y rellena los valores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# (Opcional) Google Places: precarga nombre, dirección, ubicación y la NOTA de
# Google al buscar un lugar. Si lo dejas vacío, la búsqueda usa OpenStreetMap.
# Crea la key en console.cloud.google.com y RESTRÍNGELA por dominio (HTTP referrer)
# y a la "Places API (New)". Ponle un tope de cuota para no tener cobros.
VITE_GOOGLE_MAPS_API_KEY=

# (Opcional) Gemini: lee la foto de la carta y la convierte en platos seleccionables.
# Crea la key en https://aistudio.google.com/apikey, restríngela por dominio (HTTP referrer)
# y a la "Generative Language API", y ponle un tope de cuota. Vacío = sin lector de cartas.
VITE_GEMINI_API_KEY=
