rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Perfiles de usuario: cada quien gestiona el suyo; lectura abierta a logueados.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Restaurantes: cualquier usuario logueado puede crear y editar (modo colaborativo).
    match /restaurants/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Evaluaciones: públicas (cualquiera, incluso sin login, para los links),
    // del dueño, o de un grupo (uid dentro de allowedUids).
    match /evaluations/{id} {
      allow read: if resource.data.isPublic == true
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.allowedUids != null
            && request.auth.uid in resource.data.allowedUids);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Grupos: los miembros pueden leer/editar; cualquiera logueado puede unirse
    // (agregándose a sí mismo a memberUids con el link de invitación).
    match /groups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid
            || request.auth.uid in request.resource.data.memberUids);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Wishlist: privada por usuario.
    match /wishlist/{id} {
      allow read, delete, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
