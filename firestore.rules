rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Perfiles de usuario: cada quien gestiona el suyo; lectura abierta a logueados.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Restaurantes: cualquier usuario logueado puede crear y editar (modo colaborativo).
    match /restaurants/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Evaluaciones: el dueño manda. Las públicas se pueden leer sin login (links).
    match /evaluations/{id} {
      allow read: if signedIn() || resource.data.isPublic == true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Wishlist: privada por usuario.
    match /wishlist/{id} {
      allow read, delete, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
