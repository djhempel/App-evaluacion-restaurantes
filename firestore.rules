rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Perfiles de usuario: cada quien gestiona el suyo; lectura abierta a logueados.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Restaurantes: cualquier usuario logueado puede crear y editar (modo colaborativo).
    match /restaurants/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Evaluaciones: públicas (cualquiera, incluso sin login, para los links),
    // del dueño, o de un grupo (membresía verificada EN VIVO contra el grupo,
    // para que sirva aunque alguien se una después de creada la evaluación).
    match /evaluations/{id} {
      allow read: if resource.data.isPublic == true
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.groupId != null
            && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Grupos: los miembros pueden leer/editar; cualquiera logueado puede unirse
    // (agregándose a sí mismo a memberUids con el link de invitación).
    match /groups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid
            || request.auth.uid in request.resource.data.memberUids);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Wishlist: personal (del dueño) o compartida con un grupo (sus miembros).
    function wishlistMember() {
      return resource.data.groupId != null
        && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids;
    }
    match /wishlist/{id} {
      allow read, update, delete: if signedIn()
        && (resource.data.userId == request.auth.uid || wishlistMember());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
